{
  "manifest_version": 3,
  "name": "Product Content Collector",
  "short_name": "Content Collector",
  "version": "1.0.0",
  "description": "Visually collect product content from websites into an Excel workbook for WooCommerce and other shops.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Product Content Collector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "tabs", "scripting", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"]
}
